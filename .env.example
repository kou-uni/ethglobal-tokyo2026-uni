# ─── Chain ────────────────────────────────────────────────────────────────
# Public RPCs rate-limit under load. Use your own key.
SEPOLIA_RPC_URL=

# ENSv2 on Sepolia was REDEPLOYED 2026-09-15 — published articles are stale.
# Take current addresses from ens-contracts / docs, not from a blog post.
ENS_REGISTRY_ADDRESS=
ENS_RESOLVER_ADDRESS=
# Read-only ENS compatibility check: use the seller's resolver instance, not its implementation.
ENS_NAME=
ENS_OWNER_ADDRESS=
ENS_DELEGATE_ADDRESS=
# ENSv2 registration is paid in USDC/DAI, NOT ETH. A mock token stands in here.
MOCK_USDC_ADDRESS=

# ─── Curvegrid MultiBaas ──────────────────────────────────────────────────
MULTIBAAS_DEPLOYMENT_URL=
MULTIBAAS_API_KEY=

# ─── World ID for Agents ──────────────────────────────────────────────────
# Proofs are MOCKED during the hackathon (official). Never treat as production.
WORLD_APP_ID=
WORLD_ACTION_ID=
# Server-side only. Never expose to the client.
WORLD_API_KEY=

# ─── Payment screening (only if intercepta becomes the third slot) ────────
# Mocked or hard-coded responses do not qualify. A live call must decide.
INTERCEPTA_API_KEY=
INTERCEPTA_ENDPOINT=

# ─── Router defaults (the owner can override these per policy) ────────────
YOHAKU_DAILY_CAP=3
YOHAKU_NOTIFY_HOUR=7
YOHAKU_DEFAULT_DEADLINE_HOURS=12

# ─── Classifier (rule 9 only) ─────────────────────────────────────────────
# The model may answer only 'ask' or 'drop'. There is no value that grants
# access, so a successful prompt injection can at most get a request dropped.
ANTHROPIC_API_KEY=

# Either provider works — the guarantee is in the schema, not the model.
OPENAI_API_KEY=
# No default on purpose — model names change. `npm run setup` lists what your key can use.
OPENAI_MODEL=

# ─── World ID for Agents ──────────────────────────────────────────────────
# Endpoints are NOT listed here — they come from the issuer's discovery
# document at run time. `npm run world:check` prints what it currently offers.
WORLD_ISSUER=https://sandbox.auth.world.org
# One of the values the issuer advertises in acr_values_supported.
WORLD_REQUIRED_ACR=
# How recently they must have authenticated for an approval to count.
WORLD_MAX_AGE_SECONDS=120
# Must be HTTPS — the portal rejects http://localhost.
WORLD_REDIRECT_URI=
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
