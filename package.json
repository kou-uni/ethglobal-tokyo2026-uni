{
  "name": "yohaku",
  "version": "0.0.1",
  "private": true,
  "description": "An escalation router for the agent economy — routes incoming agent requests into auto / human / deny.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ens:check": "tsx scripts/ens-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "build:demo": "tsc -p tsconfig.build.json && node scripts/build-demo.mjs",
    "demo": "npm run build:demo && open demo/index.html",
    "classify": "tsx scripts/classify.ts",
    "setup": "tsx scripts/setup-key.ts",
    "models": "tsx scripts/models.ts",
    "verify": "tsx scripts/verify.ts",
    "check": "npm run typecheck && npm test && npm run verify",
    "world:check": "tsx scripts/world-check.ts",
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "night": "tsx scripts/demo-night.ts",
    "setup:world": "tsx scripts/setup-world.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@ensdomains/ensjs": "5.0.0-sepolia-fix.1",
    "jose": "^6.2.12",
    "openai": "^7.23.0",
    "viem": "^2.56.9"
  }
}
