{
  "name": "yohaku",
  "version": "0.0.1",
  "private": true,
  "description": "An escalation router for the agent economy — routes incoming agent requests into auto / human / deny.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:idkit-key": "tsx scripts/setup-idkit-key.ts",
    "probe:idkit": "tsx scripts/probe-idkit.ts",
    "ens:check": "tsx scripts/ens-check.ts",
    "ens:probe": "tsx scripts/ens-probe.ts",
    "ens:registration": "tsx scripts/ens-registration.ts",
    "setup:ens": "tsx scripts/setup-ens.ts",
    "setup:ens-delegation": "tsx scripts/setup-ens-delegate.ts",
    "setup:ens-server": "tsx scripts/setup-ens-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.setup.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "build:demo": "tsc -p tsconfig.build.json && node scripts/build-demo.mjs",
    "demo": "npm run build:demo && open demo/index.html",
    "classify": "tsx scripts/classify.ts",
    "setup": "tsx scripts/setup-key.ts",
    "models": "tsx scripts/models.ts",
    "verify": "tsx scripts/verify.ts",
    "check": "npm run typecheck && npm test && npm run verify",
    "world:check": "tsx scripts/world-check.ts",
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "night": "tsx scripts/demo-night.ts",
    "setup:world": "tsx scripts/setup-world.ts",
    "agent": "tsx scripts/agent.ts",
    "setup:wallet": "tsx scripts/setup-wallet.ts",
    "stage": "tsx scripts/stage-demo.ts",
    "setup:jev": "tsx scripts/setup-jev.ts",
    "jev:check": "tsx scripts/jev-check.ts",
    "simulate": "tsx scripts/simulate.ts",
    "setup:intercepta": "tsx scripts/setup-intercepta.ts",
    "intercepta:check": "tsx scripts/intercepta-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@ensdomains/ensjs": "5.0.0-sepolia-fix.1",
    "@worldcoin/idkit-core": "4.3.0",
    "@worldcoin/idkit-server": "1.1.1",
    "@x402/core": "^2.27.0",
    "jose": "^6.2.12",
    "openai": "^7.23.0",
    "qrcode": "1.5.4",
    "viem": "^2.56.9"
  },
  "homepage": "https://kou-uni.github.io/ethglobal-tokyo2026-uni/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kou-uni/ethglobal-tokyo2026-uni"
  }
}
